---
import Base from "../layouts/Base.astro";
---

<Base
  title="Not found · Atrinik Observatory"
  description="The requested Observatory route does not exist."
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">Signal lost</p>
    <h1 id="not-found-title">This coordinate is unknown.</h1>
    <p>The route you requested is not part of the Observatory surface.</p>
    <a class="not-found-link" href="/"
      >Return to the dashboard <span aria-hidden="true">↗</span></a
    >
  </section>
</Base>
