{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atrinik-observatory-probes",
  "main": "src/probe-worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atrinik-observatory",
      "database_id": "dd64e9e5-807c-4700-9b05-60eff63e3061",
      "migrations_dir": "migrations",
    },
  ],
  "services": [
    {
      "binding": "RENDEZVOUS_HEALTH",
      "service": "atrinik-metaserver",
      "entrypoint": "RendezvousHealth",
    },
  ],
  "secrets": {
    "required": ["RENDEZVOUS_HEALTH_EXPORT_TOKEN"],
  },
  "vars": {
    "OBSERVATORY_ENV": "production",
    "PROBE_TIMEOUT_MS": "5000",
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
