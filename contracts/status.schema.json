{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatory.atrinik.org/contracts/status.schema.json",
  "title": "Atrinik Observatory status document",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "staleAfterSeconds",
    "coordinates",
    "services",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "staleAfterSeconds": { "type": "integer", "minimum": 1 },
    "coordinates": { "type": "array", "items": { "$ref": "#/$defs/coordinate" } },
    "services": {
      "type": "array",
      "items": {
        "oneOf": [{ "$ref": "#/$defs/service" }, { "$ref": "#/$defs/metaserver" }]
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "healthy", "attention", "stale", "unknown"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "healthy": { "type": "integer", "minimum": 0 },
        "attention": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "observationStatus": {
      "enum": ["passed", "failed", "cancelled", "running", "unknown"]
    },
    "displayStatus": {
      "enum": [
        "passed",
        "failed",
        "cancelled",
        "running",
        "unknown",
        "attention",
        "stale",
        "not-tracked"
      ]
    },
    "listingFormat": {
      "enum": ["root", "html", "json", "xml"]
    },
    "coordinate": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "component",
        "stack",
        "generation",
        "deploymentApplicable",
        "overall",
        "build",
        "release",
        "package",
        "deployment"
      ],
      "properties": {
        "id": { "type": "string" },
        "repository": { "type": "string" },
        "component": { "type": "string" },
        "stack": { "enum": ["default", "classic"] },
        "generation": { "enum": ["replacement", "classic", "shared"] },
        "deploymentApplicable": { "type": "boolean" },
        "overall": { "$ref": "#/$defs/displayStatus" },
        "build": { "$ref": "#/$defs/evidence" },
        "release": { "$ref": "#/$defs/evidence" },
        "package": { "$ref": "#/$defs/evidence" },
        "deployment": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "status",
        "lastObservedStatus",
        "observedAt",
        "ageSeconds",
        "stale",
        "latest",
        "lastKnownGood",
        "mostRecentFailure"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/displayStatus" },
        "lastObservedStatus": {
          "anyOf": [{ "$ref": "#/$defs/observationStatus" }, { "type": "null" }]
        },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "ageSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "stale": { "type": "boolean" },
        "latest": {
          "anyOf": [{ "$ref": "#/$defs/evidenceRecord" }, { "type": "null" }]
        },
        "lastKnownGood": {
          "anyOf": [{ "$ref": "#/$defs/evidenceRecord" }, { "type": "null" }]
        },
        "mostRecentFailure": {
          "anyOf": [{ "$ref": "#/$defs/evidenceRecord" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "evidenceRecord": {
      "type": "object",
      "required": [
        "id",
        "status",
        "observedAt",
        "receivedAt",
        "ref",
        "commitSha",
        "title",
        "sourceUrl",
        "workflowName",
        "releaseTag",
        "packageUrl",
        "artifactUrl"
      ],
      "properties": {
        "id": { "type": "string" },
        "status": { "$ref": "#/$defs/observationStatus" },
        "observedAt": { "type": "string", "format": "date-time" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "ref": { "type": ["string", "null"] },
        "commitSha": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "workflowName": { "type": ["string", "null"] },
        "releaseTag": { "type": ["string", "null"] },
        "packageUrl": { "type": ["string", "null"], "format": "uri" },
        "artifactUrl": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url",
        "stack",
        "staleAfterSeconds",
        "surface",
        "format",
        "evidenceUrl",
        "status",
        "lastObservedStatus",
        "observedAt",
        "ageSeconds",
        "stale",
        "statusCode",
        "responseMs",
        "error"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "stack": { "enum": ["default", "classic"] },
        "staleAfterSeconds": { "type": "integer", "minimum": 1 },
        "surface": { "const": "service" },
        "format": { "type": "null" },
        "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
        "status": { "$ref": "#/$defs/displayStatus" },
        "lastObservedStatus": {
          "anyOf": [{ "$ref": "#/$defs/observationStatus" }, { "type": "null" }]
        },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "ageSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "stale": { "type": "boolean" },
        "statusCode": { "type": ["integer", "null"] },
        "responseMs": { "type": ["integer", "null"], "minimum": 0 },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "listingFormatSummary": {
      "type": "object",
      "required": [
        "format",
        "label",
        "url",
        "status",
        "lastObservedStatus",
        "observedAt",
        "ageSeconds",
        "stale",
        "statusCode",
        "responseMs",
        "generation",
        "entryCount",
        "parityKey",
        "error"
      ],
      "properties": {
        "format": { "$ref": "#/$defs/listingFormat" },
        "label": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "status": { "$ref": "#/$defs/displayStatus" },
        "lastObservedStatus": {
          "anyOf": [{ "$ref": "#/$defs/observationStatus" }, { "type": "null" }]
        },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "ageSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "stale": { "type": "boolean" },
        "statusCode": { "type": ["integer", "null"] },
        "responseMs": { "type": ["integer", "null"], "minimum": 0 },
        "generation": { "type": ["string", "null"] },
        "entryCount": { "type": ["integer", "null"], "minimum": 0 },
        "parityKey": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "listingsSurface": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "observedAt",
        "ageSeconds",
        "stale",
        "requiredFormats",
        "availableFormats",
        "generation",
        "entryCount",
        "crossFormatSkew",
        "evidenceUrl",
        "formats"
      ],
      "properties": {
        "id": { "const": "listings" },
        "name": { "const": "Listings" },
        "status": { "$ref": "#/$defs/displayStatus" },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "ageSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "stale": { "type": "boolean" },
        "requiredFormats": {
          "type": "array",
          "items": { "$ref": "#/$defs/listingFormat" },
          "minItems": 4,
          "uniqueItems": true
        },
        "availableFormats": { "type": "integer", "minimum": 0 },
        "generation": { "type": ["string", "null"] },
        "entryCount": { "type": ["integer", "null"], "minimum": 0 },
        "crossFormatSkew": { "type": "boolean" },
        "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
        "formats": {
          "type": "array",
          "items": { "$ref": "#/$defs/listingFormatSummary" },
          "minItems": 4
        }
      },
      "additionalProperties": false
    },
    "rendezvousSurface": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "observedAt",
        "ageSeconds",
        "stale",
        "routeStatus",
        "controlsStatus",
        "admissionStatus",
        "observationSource",
        "safeObservationAvailable",
        "evidenceUrl",
        "error"
      ],
      "properties": {
        "id": { "const": "rendezvous" },
        "name": { "const": "Rendezvous rooms" },
        "status": { "$ref": "#/$defs/displayStatus" },
        "observedAt": { "const": null },
        "ageSeconds": { "const": null },
        "stale": { "const": false },
        "routeStatus": { "$ref": "#/$defs/displayStatus" },
        "controlsStatus": { "$ref": "#/$defs/displayStatus" },
        "admissionStatus": { "$ref": "#/$defs/displayStatus" },
        "observationSource": { "type": ["string", "null"] },
        "safeObservationAvailable": { "const": false },
        "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metaserver": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url",
        "stack",
        "staleAfterSeconds",
        "surface",
        "format",
        "evidenceUrl",
        "status",
        "lastObservedStatus",
        "observedAt",
        "ageSeconds",
        "stale",
        "statusCode",
        "responseMs",
        "error",
        "surfaces"
      ],
      "properties": {
        "id": { "const": "metaserver" },
        "name": { "const": "Atrinik metaserver" },
        "url": { "type": "string", "format": "uri" },
        "stack": { "enum": ["default", "classic"] },
        "staleAfterSeconds": { "type": "integer", "minimum": 1 },
        "surface": { "const": "metaserver" },
        "format": { "type": "null" },
        "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
        "status": { "$ref": "#/$defs/displayStatus" },
        "lastObservedStatus": {
          "anyOf": [{ "$ref": "#/$defs/observationStatus" }, { "type": "null" }]
        },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "ageSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "stale": { "type": "boolean" },
        "statusCode": { "type": ["integer", "null"] },
        "responseMs": { "type": ["integer", "null"], "minimum": 0 },
        "error": { "type": ["string", "null"] },
        "surfaces": {
          "type": "object",
          "required": ["listings", "rendezvous"],
          "properties": {
            "listings": { "$ref": "#/$defs/listingsSurface" },
            "rendezvous": { "$ref": "#/$defs/rendezvousSurface" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
