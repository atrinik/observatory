{
  "schemaVersion": 1,
  "provider": "cloudflare-workers",
  "worker": "atrinik-observatory-probes",
  "repository": "atrinik/observatory",
  "entrypoint": "src/probe-worker.ts",
  "previewConfig": "wrangler.probes.jsonc",
  "productionConfig": "wrangler.probes.production.jsonc",
  "productionEnvironment": "production",
  "previewEnvironment": "preview",
  "cron": "*/5 * * * *",
  "productionDatabase": "atrinik-observatory",
  "previewDatabase": "atrinik-observatory-preview",
  "responseBodyPolicy": "never persist probe response bodies",
  "rollback": "wrangler rollback to the last verified Worker version"
}
