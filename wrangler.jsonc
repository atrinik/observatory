{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atrinik-observatory",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atrinik-observatory-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "OBSERVATORY_ENV": "local",
    "STALE_AFTER_SECONDS": "21600",
    "SERVICE_STALE_AFTER_SECONDS": "1800",
  },
  "secrets": {
    "required": ["GITHUB_WEBHOOK_SECRET"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "env": {
    "preview": {
      "name": "atrinik-observatory-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "atrinik-observatory-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "OBSERVATORY_ENV": "preview",
        "STALE_AFTER_SECONDS": "21600",
        "SERVICE_STALE_AFTER_SECONDS": "1800",
      },
    },
    "production": {
      "name": "atrinik-observatory",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "atrinik-observatory",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "OBSERVATORY_ENV": "production",
        "STALE_AFTER_SECONDS": "21600",
        "SERVICE_STALE_AFTER_SECONDS": "1800",
      },
    },
  },
}
