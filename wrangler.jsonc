{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atrinik-observatory",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atrinik-observatory-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "OBSERVATORY_ENV": "local",
    "STALE_AFTER_SECONDS": "21600",
    "SERVICE_STALE_AFTER_SECONDS": "1800",
  },
  "env": {
    "preview": {
      "name": "atrinik-observatory-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "atrinik-observatory-preview",
          "database_id": "8e21bf32-ed2c-47d8-8df3-0f58346ef370",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "OBSERVATORY_ENV": "preview",
        "STALE_AFTER_SECONDS": "21600",
        "SERVICE_STALE_AFTER_SECONDS": "1800",
      },
    },
    "production": {
      "name": "atrinik-observatory",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "atrinik-observatory",
          "database_id": "dd64e9e5-807c-4700-9b05-60eff63e3061",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "OBSERVATORY_ENV": "production",
        "STALE_AFTER_SECONDS": "21600",
        "SERVICE_STALE_AFTER_SECONDS": "1800",
      },
    },
  },
}
